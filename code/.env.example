# Google Generative AI API Key (Required)
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your_api_key_here

# Optional: Defaults to gemini-2.5-flash if not set
GOOGLE_GENERATIVE_AI_MODEL=gemini-2.5-flash

# ─────────────────────────────────────────────────────────────────────
# 可选：配置 Anthropic (Claude) API
# 如果在公司内网，还可以配置自定义的 Base URL 进行代理请求
# ─────────────────────────────────────────────────────────────────────
# DEFAULT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_BASE_URL=https://api.your-company.com/v1

# ─────────────────────────────────────────────────────────────────────
# 可选：使用本地 LM Studio 部署向量模型（替代 Google Embedding）
# 如果配置了下面两个变量，系统将优先使用 LM Studio；否则回退到 Google text-embedding-004。
#
# 1. 在 LM Studio 中加载好一个 Embedding 模型（如 nomic-embed-text-v1.5）
# 2. 点击 "Start Server"（默认地址 http://localhost:1234）
# 3. 复制模型的 Model ID 填到下面
# ─────────────────────────────────────────────────────────────────────
# LM_STUDIO_BASE_URL=http://localhost:1234/v1
# LM_STUDIO_EMBEDDING_MODEL=nomic-embed-text-v1.5
